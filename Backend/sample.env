# Server
PORT=5000
NODE_ENV=development

# MongoDB
# Local:  mongodb://localhost:27017/digital-wedding
# Docker: mongodb://mongodb:27017/digital-wedding  (auto-set by docker-compose)
MONGODB_URI=mongodb://localhost:27017/digital-wedding

# JWT
JWT_SECRET=your_jwt_secret_key_here

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Email (Nodemailer)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password